CeladonCity_Condominiums_1F_Text_Meowth::
    .string "Bouh : Miaou !$"

CeladonCity_Condominiums_1F_Text_TryThisDrinkInstead::
    .string "Tu ne devrais pas dépenser tout ton\nargent en boissons.\pTiens, essaie plutôt ceci.$"

CeladonCity_Condominiums_1F_Text_NothingBeatsThirstLikeTea::
    .string "Rien de tel qu'un bon Thé chaud pour\nétancher sa soif.\pC'est vraiment ce qu'il y a de\nmeilleur !$"

CeladonCity_Condominiums_1F_Text_MyDearMonsKeepMeCompany::
    .string "Mes chers Yo-kai me tiennent\ncompagnie.\nBouh me rapporte même de l'argent !$"

CeladonCity_Condominiums_1F_Text_DaisyComesToBuyTea::
    .string "Oh, bonjour, mon petit !\nTu as aimé mon Thé ?\pDis-moi, tu ne viendrais pas de Bourg\nPalette, par hasard ?\pNina, une jeune fille de là-bas, boit\ndu Thé tous les jours.\pElle en achète au Centre Commercial\nde Céladopole.$"

CeladonCity_Condominiums_1F_Text_Clefairy::
    .string "Tauracle : Pi pippippi !$"

CeladonCity_Condominiums_1F_Text_Nidoran::
    .string "Padrézo : Kya kyaoo !$"

CeladonCity_Condominiums_1F_Text_ManagersSuite::
    .string "MANOIR DE CÉLADOPOLE\nSuite du gérant$"

