PewterCity_Gym_Text_BrockIntro::
    .string "WYATT: Tu as observé les traces\n"
    .string "laissées dans la roche.\p"
    .string "Un explorateur doit regarder\n"
    .string "avant de se précipiter!\p"
    .string "À présent, montre-moi les liens\n"
    .string "qui t'unissent à tes Yo-kai!{PLAY_BGM}{MUS_ENCOUNTER_GYM_LEADER}$"

PewterCity_Gym_Text_BrockDefeat::
    .string "Bien joué! Vous formez\n"
    .string "une vraie équipe!$"

PewterCity_Gym_Text_FirstTrophy::
    .string "WYATT: Tu mérites ton premier\n"
    .string "trophée. Félicitations!\p"
    .string "{PLAYER} reçoit\n"
    .string "le trophée d'Argenta!\p"
    .string "Il te permet d'utiliser Flash\n"
    .string "avec un Yo-kai qui le connaît.$"

PewterCity_Gym_Text_TakeThisWithYou::
    .string "WYATT: Emporte aussi cette CT.$"

PewterCity_Gym_Text_ReceivedTM39FromBrock::
    .string "Wyatt remet\n"
    .string "la CT39 à {PLAYER}.$"

PewterCity_Gym_Text_ExplainTM39::
    .string "La CT39 enseigne Tomberoche.\n"
    .string "Elle ne sert qu'une fois.\p"
    .string "Les rochers ralentissent la cible.\n"
    .string "Choisis bien ton partenaire!$"

PewterCity_Gym_Text_BrockPostBattle::
    .string "WYATT: La route vers Azuria\n"
    .string "traverse le Mont Sélénite.\p"
    .string "Explore, observe et prends soin\n"
    .string "de ton équipe!$"

PewterCity_Gym_Text_DontHaveRoomForThis::
    .string "Ton sac est plein. Reviens\n"
    .string "chercher ta CT quand tu veux.$"

PewterCity_Gym_Text_LiamIntro::
    .string "Un explorateur doit aussi\n"
    .string "savoir protéger son équipe!$"

PewterCity_Gym_Text_LiamDefeat::
    .string "Tu sais garder ton calme!$"

PewterCity_Gym_Text_LiamPostBattle::
    .string "Les deux stèles sont accessibles\n"
    .string "dans l'ordre de ton choix.$"

PewterCity_Gym_Text_LetMeTakeYouToTheTop::
    .string "Bienvenue au chantier de Wyatt!\n"
    .string "Veux-tu un conseil? $"

PewterCity_Gym_Text_LetsGetHappening::
    .string "Observe les deux stèles\n"
    .string "au milieu des rochers.$"

PewterCity_Gym_Text_ItsFreeLetsGetHappening::
    .string "Un petit indice pour la route!$"

PewterCity_Gym_Text_TryDifferentPartyOrders::
    .string "Wyatt utilise des Yo-kai Roche.\p"
    .string "Examine les stèles de chaque côté.\n"
    .string "Le passage central mène à lui.$"

PewterCity_Gym_Text_YoureChampMaterial::
    .string "Ton premier trophée!\n"
    .string "Le voyage ne fait que commencer.$"

PewterCity_Gym_Text_GymStatue::
    .string "FOUILLES D'ARGENTA\n"
    .string "CHAMPION: WYATT\p"
    .string "Épreuve: explorer et observer.$"

PewterCity_Gym_Text_GymStatuePlayerWon::
    .string "FOUILLES D'ARGENTA\n"
    .string "CHAMPION: WYATT\p"
    .string "Épreuve réussie: {PLAYER}.$"

PewterCity_Gym_Text_Relic1::
    .string "Une stèle gravée d'empreintes.\p"
    .string "La pierre garde les traces\n"
    .string "de ceux qui l'ont parcourue.\p"
    .string "Tu observes soigneusement\n"
    .string "la première stèle.$"

PewterCity_Gym_Text_Relic2::
    .string "Des fragments assemblés\n"
    .string "forment un rempart.\p"
    .string "Même les petites pierres\n"
    .string "deviennent solides ensemble.\p"
    .string "Tu observes soigneusement\n"
    .string "la seconde stèle.$"

PewterCity_Gym_Text_ReadRelicsFirst::
    .string "WYATT: Explore les deux stèles\n"
    .string "avant de venir me défier.$"

PewterCity_Gym_Text_HearSpeechFirst::
    .string "Une foule s'est rassemblée\n"
    .string "à l'entrée sud d'Argenta.\p"
    .string "Il faut voir ce qui s'y passe.$"

PewterCity_Gym_Text_RematchOffer::
    .string "WYATT: Prêt pour une revanche\n"
    .string "avec mon équipe d'exploration?$"

PewterCity_Gym_Text_StoneBagFull::
    .string "Garde une place dans ton sac.\n"
    .string "Ta Pierre Eau t'attend.$"
