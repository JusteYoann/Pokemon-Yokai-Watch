Route16_Text_LaoIntro::
    .string "Qu'est-ce que tu veux ?$"

Route16_Text_LaoDefeat::
    .string "Ne t'avise pas de rire !$"

Route16_Text_LaoPostBattle::
    .string "On aime bien traîner ici.\nQu'est-ce que ça peut te faire ?$"

Route16_Text_KojiIntro::
    .string "Joli Vélo ! Donne-le-moi !$"

Route16_Text_KojiDefeat::
    .string "K.O. !$"

Route16_Text_KojiPostBattle::
    .string "Laisse tomber ! Qui a besoin de ta\nBicyclette ?$"

Route16_Text_LukeIntro::
    .string "Sors jouer, petite souris !$"

Route16_Text_LukeDefeat::
    .string "Petit vaurien !$"

Route16_Text_LukePostBattle::
    .string "Je déteste perdre ! Hors de ma vue\n!$"

Route16_Text_HideoIntro::
    .string "Hé, tu viens de me bousculer !$"

Route16_Text_HideoDefeat::
    .string "Boum !$"

Route16_Text_HideoPostBattle::
    .string "Que ça te plaise ou non, on restera\ntoujours dans le coin.\pDepuis Parmanie, tu peux rejoindre\nCarmin-sur-Mer en longeant la côte.$"

Route16_Text_CamronIntro::
    .string "J'ai faim et je suis de mauvaise\nhumeur !\nIl me faut un défouloir !$"

Route16_Text_CamronDefeat::
    .string "Mauvais, mauvais, mauvais !$"

Route16_Text_CamronPostBattle::
    .string "Si je dois avoir des Yo-kai, autant\nqu'ils soient féroces.\pIls mettront mes ennemis en pièces.$"

Route16_Text_RubenIntro::
    .string "Hé, toi !\nAmusons-nous un peu !$"

Route16_Text_RubenDefeat::
    .string "Ne me mets pas en colère !$"

Route16_Text_RubenPostBattle::
    .string "Je m'amuse à embêter les gens avec\nmes Yo-kai malodorants.\pIls sont parfaits pour leur faire\npeur.\nEt en plus, ils mordent.$"

Route16_Text_MonSprawledOutInSlumber::
    .string "Un MISTERRE dort profondément.\nIl bloque tout le passage.$"

Route16_Text_CyclingRoadSign::
    .string "Profitez de la descente !\nPISTE CYCLABLE$"

Route16_Text_RouteSign::
    .string "ROUTE 16\nCÉLADOPOLE - PARMANIE$"

Route16_Text_JedIntro::
    .string "Jed : Notre amour est sans limites.\nNous nous aimons et nous le montrons\l!$"

Route16_Text_JedDefeat::
    .string "Jed : Oh non !\nMon amour m'a vu perdre !$"

Route16_Text_JedPostBattle::
    .string "Jed : Écoute, Léa.\nTu dois moins te concentrer sur moi.$"

Route16_Text_JedNotEnoughMons::
    .string "Jed : Tu n'as qu'un seul Yo-kai ?\nN'as-tu pas d'amour dans le coeur ?$"

Route16_Text_LeaIntro::
    .string "Léa : Parfois, l'intensité de notre\namour me fait peur.$"

Route16_Text_LeaDefeat::
    .string "Léa : Oh ! Mais Jed reste beau, même\ndans la défaite !$"

Route16_Text_LeaPostBattle::
    .string "Léa : Hihi, pardon.\nJed est tellement beau.$"

Route16_Text_LeaNotEnoughMons::
    .string "Léa : Tu n'as pas deux Yo-kai avec\ntoi ?\pToi et ton Yo-kai, vous ne vous\nsentez pas seuls ?$"
