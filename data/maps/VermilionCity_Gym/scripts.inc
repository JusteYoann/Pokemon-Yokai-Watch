VermilionCity_Gym_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, VermilionCity_Gym_OnTransition
	.byte 0

VermilionCity_Gym_OnTransition::
	setflag FLAG_SCENARIO_CARMIN_GYM_CURRENT
	end

VermilionCity_Gym_EventScript_DoorDream::
	lockall
	goto_if_unset FLAG_BADGE02_GET, VermilionCity_Gym_NeedsSecondAll
	msgbox VermilionCity_Gym_Text_DoorDream
	closemessage
	warp MAP_VERMILION_CITY_MYSTERY_DREAM, 255, 7, 12
	waitstate
	releaseall
	end
VermilionCity_Gym_EventScript_DoorMemory::
	lockall
	goto_if_unset FLAG_BADGE02_GET, VermilionCity_Gym_NeedsSecondAll
	msgbox VermilionCity_Gym_Text_DoorMemory
	closemessage
	warp MAP_VERMILION_CITY_MYSTERY_MEMORY, 255, 7, 12
	waitstate
	releaseall
	end
VermilionCity_Gym_EventScript_DoorVigil::
	lockall
	goto_if_unset FLAG_BADGE02_GET, VermilionCity_Gym_NeedsSecondAll
	msgbox VermilionCity_Gym_Text_DoorVigil
	closemessage
	warp MAP_VERMILION_CITY_MYSTERY_VIGIL, 255, 3, 12
	waitstate
	releaseall
	end
VermilionCity_Gym_NeedsSecondAll::
	msgbox VermilionCity_Gym_Text_NeedsSecond
	releaseall
	end

VermilionCity_Gym_EventScript_Gate::
	lockall
	goto_if_unset FLAG_BADGE02_GET, VermilionCity_Gym_GateNeedsSecond
	goto_if_set FLAG_BADGE03_GET, VermilionCity_Gym_GateOpen
	goto_if_unset FLAG_SCENARIO_DOOR_DREAM_DONE, VermilionCity_Gym_GateNeedsDoors
	goto_if_unset FLAG_SCENARIO_DOOR_MEMORY_DONE, VermilionCity_Gym_GateNeedsDoors
	goto_if_unset FLAG_SCENARIO_DOOR_VIGIL_DONE, VermilionCity_Gym_GateNeedsDoors
VermilionCity_Gym_GateOpen::
	setvar VAR_TEMP_2, 1
	releaseall
	end
VermilionCity_Gym_GateNeedsSecond::
	msgbox VermilionCity_Gym_Text_NeedsSecond
	goto VermilionCity_Gym_GateStepBack
VermilionCity_Gym_GateNeedsDoors::
	msgbox VermilionCity_Gym_Text_NeedsDoors
VermilionCity_Gym_GateStepBack::
	applymovement LOCALID_PLAYER, IndigoPlateau_Movement_StepBack
	waitmovement 0
	releaseall
	end

VermilionCity_Gym_EventScript_Berenice::
	lock
	faceplayer
	goto_if_set FLAG_BADGE03_GET, VermilionCity_Gym_EventScript_AfterVictory
	goto_if_unset FLAG_BADGE02_GET, VermilionCity_Gym_ChampionNeedsSecond
	goto_if_unset FLAG_SCENARIO_DOOR_DREAM_DONE, VermilionCity_Gym_ChampionNeedsDoors
	goto_if_unset FLAG_SCENARIO_DOOR_MEMORY_DONE, VermilionCity_Gym_ChampionNeedsDoors
	goto_if_unset FLAG_SCENARIO_DOOR_VIGIL_DONE, VermilionCity_Gym_ChampionNeedsDoors
	trainerbattle_single TRAINER_SCENARIO_BERENICE, VermilionCity_Gym_Text_Intro, VermilionCity_Gym_Text_Defeat, VermilionCity_Gym_EventScript_Victory, NO_MUSIC
	goto VermilionCity_Gym_EventScript_AfterVictory
VermilionCity_Gym_ChampionNeedsSecond::
	msgbox VermilionCity_Gym_Text_NeedsSecond
	release
	end
VermilionCity_Gym_ChampionNeedsDoors::
	msgbox VermilionCity_Gym_Text_NeedsDoors
	release
	end
VermilionCity_Gym_EventScript_Victory::
	setflag FLAG_DEFEATED_LT_SURGE
	setflag FLAG_BADGE03_GET
	setflag FLAG_FOUND_BOTH_VERMILION_GYM_SWITCHES
	set_gym_trainers 3
	call_if_unset FLAG_GOT_HM05, VermilionCity_Gym_EventScript_ShowOaksAide
	playfanfare MUS_OBTAIN_BADGE
	msgbox VermilionCity_Gym_Text_ThirdTrophy
	waitfanfare
	goto VermilionCity_Gym_EventScript_GiveTM
VermilionCity_Gym_EventScript_ShowOaksAide::
	clearflag FLAG_HIDE_VERMILION_CITY_OAKS_AIDE
	return
VermilionCity_Gym_EventScript_AfterVictory::
	goto_if_unset FLAG_GOT_TM34_FROM_SURGE, VermilionCity_Gym_EventScript_GiveTM
	msgbox VermilionCity_Gym_Text_AfterVictory
	release
	end
VermilionCity_Gym_EventScript_GiveTM::
	checkitemspace ITEM_TM34
	goto_if_eq VAR_RESULT, FALSE, VermilionCity_Gym_EventScript_NoRoom
	giveitem_msg VermilionCity_Gym_Text_ReceivedTM, ITEM_TM34
	setflag FLAG_GOT_TM34_FROM_SURGE
	msgbox VermilionCity_Gym_Text_ExplainTM
	release
	end
VermilionCity_Gym_EventScript_NoRoom::
	msgbox VermilionCity_Gym_Text_NoRoom
	release
	end

VermilionCity_Gym_EventScript_Assistant::
	lock
	faceplayer
	goto_if_unset FLAG_BADGE02_GET, VermilionCity_Gym_ChampionNeedsSecond
	msgbox VermilionCity_Gym_Text_Assistant, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, VermilionCity_Gym_NoHeal
	closemessage
	special HealPlayerParty
	playfanfare MUS_HEAL
	waitfanfare
	msgbox VermilionCity_Gym_Text_Healed
VermilionCity_Gym_NoHeal::
	release
	end
VermilionCity_Gym_EventScript_Guide::
	msgbox VermilionCity_Gym_Text_Guide, MSGBOX_NPC
	end
VermilionCity_Gym_EventScript_Statue::
	msgbox VermilionCity_Gym_Text_Statue, MSGBOX_SIGN
	end
