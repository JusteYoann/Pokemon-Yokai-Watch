ViridianCity_Gym_EventScript_GymGuy::
	goto_if_set FLAG_SYS_GAME_CLEAR, SteveJaws_GymGuide
	lock
	faceplayer
	goto_if_set FLAG_DEFEATED_LEADER_GIOVANNI, ViridianCity_Gym_EventScript_GymGuyPostVictory
	msgbox ViridianCity_Gym_Text_GymGuyAdvice
	release
	end

ViridianCity_Gym_EventScript_GymGuyPostVictory::
	famechecker FAMECHECKER_GIOVANNI, 4
	msgbox ViridianCity_Gym_Text_GymGuyPostVictory
	release
	end

ViridianCity_Gym_EventScript_GymStatue::
	goto_if_set FLAG_SYS_GAME_CLEAR, SteveJaws_GymStatue
	lockall
	goto_if_set FLAG_BADGE08_GET, ViridianCity_Gym_EventScript_GymStatuePostVictory
	msgbox ViridianCity_Gym_Text_GymStatue
	releaseall
	end

ViridianCity_Gym_EventScript_GymStatuePostVictory::
	msgbox ViridianCity_Gym_Text_GymStatuePlayerWon
	releaseall
	end

SteveJaws_GymLoad::
	setflag FLAG_HIDE_STEVE_JAWS_GYM
	goto_if_unset FLAG_SYS_GAME_CLEAR, SteveJaws_GymLoadEnd
	setflag FLAG_HIDE_VIRIDIAN_GIOVANNI
	clearflag FLAG_HIDE_STEVE_JAWS_GYM
SteveJaws_GymLoadEnd::
	end

SteveJaws_Gym::
	lock
	faceplayer
	msgbox SteveJaws_Text_Offer, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, EventScript_ReleaseEnd
	cleartrainerflag TRAINER_STEVE_JAWS
	trainerbattle_single TRAINER_STEVE_JAWS, SteveJaws_Text_Start, SteveJaws_Text_Defeat, SteveJaws_GymWon
	release
	end
SteveJaws_GymWon::
	msgbox SteveJaws_Text_Won
	release
	end
SteveJaws_GymGuide::
	msgbox SteveJaws_Text_Guide, MSGBOX_NPC
	end
SteveJaws_GymStatue::
	msgbox SteveJaws_Text_Statue, MSGBOX_SIGN
	end
SteveJaws_Text_Offer::
	.string "Steve Jaws: J'ai repris cette\nArène après le départ de Morléone.\pMes Yo-kai ont la force de l'Acier!\nPrêt à relever le défi?$"
SteveJaws_Text_Start::
	.string "Mettons tes talents à l'épreuve!$"
SteveJaws_Text_Defeat::
	.string "Une démonstration remarquable!$"
SteveJaws_Text_Won::
	.string "Steve Jaws: Solide, précis...\nTu as tout d'un grand Champion!\pReviens quand tu veux.\nMon équipe sera prête!$"
SteveJaws_Text_Guide::
	.string "Steve Jaws dirige cette Arène.\nIl compte surtout sur l'Acier!$"
SteveJaws_Text_Statue::
	.string "ARÈNE DE JADIELLE\nCHAMPION: STEVE JAWS$"
