CeruleanCity_Gym_Text_MistyIntro::
    .string "Katie, à ton service !\pLes Yo-kai de type Normal\nont plus d’un tour dans leur sac.\pEt mon ami Jibanyan\na aussi très envie de jouer !\pAllez, {PLAYER} !\nDonnons le meilleur de nous-mêmes !{PLAY_BGM}{MUS_ENCOUNTER_GYM_LEADER}$"


CeruleanCity_Gym_Text_ExplainTM03::
    .string "La CT03 enseigne Vibraqua.\pChoisis un Yo-kai compatible\nqui en fera bon usage!$"

CeruleanCity_Gym_Text_ExplainCascadeBadge::
    .string "Avec le Badge Cascade,\nles Yo-kai jusqu'au niveau 30\lt'obéiront, même ceux échangés.\pTu peux aussi utiliser Coupe\nen dehors des combats.\pCela permet de couper\nles petits arbres gênants.\pPrends aussi ma CT préférée!$"

CeruleanCity_Gym_Text_ReceivedTM03FromMisty::
    .string "{CHAMPION_AZURIA} remet\nla CT03 à {PLAYER}.$"

CeruleanCity_Gym_Text_BetterMakeRoomForThis::
    .string "Il faut faire de la place!$"

CeruleanCity_Gym_Text_MistyDefeat::
    .string "Quel beau combat !\nBravo, {PLAYER} !\pLe Badge Cascade est à toi !$"


CeruleanCity_Gym_Text_DianaIntro::
    .string "Quoi? Toi?\nJe suis largement à ta hauteur!\pInutile de déranger {CHAMPION_AZURIA}.$"

CeruleanCity_Gym_Text_DianaDefeat::
    .string "Tu m'as submergée!$"

CeruleanCity_Gym_Text_DianaPostBattle::
    .string "Il faut affronter d'autres Dresseurs\npour connaître son vrai niveau.$"

CeruleanCity_Gym_Text_LuisIntro::
    .string "Plouf!\pJe passe en premier!\nC'est parti!$"

CeruleanCity_Gym_Text_LuisDefeat::
    .string "Ce n'est pas possible!$"

CeruleanCity_Gym_Text_LuisPostBattle::
    .string "{CHAMPION_AZURIA} et ses Yo-kai\nne cessent de progresser !$"


CeruleanCity_Gym_Text_GymGuyAdvice::
    .string "Le type Normal est polyvalent.\pMéfie-toi de Crocho !\nJibanyan termine l’équipe.\pLui, il garde son type Feu !\nPrépare ta stratégie !$"


CeruleanCity_Gym_Text_WeMakePrettyGoodTeam::
    .string "Tu as battu {CHAMPION_AZURIA}!\nJe te l'avais bien dit!\pToi et moi,\non fait une sacrée équipe!$"

CeruleanCity_Gym_Text_GymStatue::
    .string "ARÈNE D’AZURIA\n{CHAMPION_AZURIA} - Type Normal\pDRESSEURS VICTORIEUX :\n{RIVAL}$"


CeruleanCity_Gym_Text_GymStatuePlayerWon::
    .string "ARÈNE D’AZURIA\n{CHAMPION_AZURIA} - Type Normal\pDRESSEURS VICTORIEUX :\n{RIVAL}, {PLAYER}$"


CeruleanCity_Gym_Text_NathanIntro::
    .string "Hé, {PLAYER} ! C’est Nathan !\pMes amis Yo-kai et moi,\non forme une sacrée équipe.\pNos types Normal savent se battre.\nJibanyan aussi est prêt !\pÀ toi de nous montrer ta force !{PLAY_BGM}{MUS_ENCOUNTER_GYM_LEADER}$"
