CeruleanCity_BikeShop_Text_WelcomeToBikeShop::
    .string "Bonjour!\nBienvenue au Magasin de Vélos.\pNous avons forcément\nle vélo qu'il te faut!$"

CeruleanCity_BikeShop_Text_SorryYouCantAffordIt::
    .string "Désolé!\nTu n'as pas assez d'argent!$"

CeruleanCity_BikeShop_Text_OhBikeVoucherHereYouGo::
    .string "Oh! C'est…\pUn Bon Commande!\pTrès bien!\nVoici ton vélo!$"

CeruleanCity_BikeShop_Text_ExchangedVoucherForBicycle::
    .string "{PLAYER} échange\nle Bon Commande contre une\lBicyclette.$"

CeruleanCity_BikeShop_Text_ThankYouComeAgain::
    .string "Merci!\nReviens nous voir!$"

CeruleanCity_BikeShop_Text_HowDoYouLikeNewBicycle::
    .string "Alors, ta nouvelle Bicyclette?\nElle roule bien?\pTu peux l'utiliser sur la Piste\nCyclable et même dans les grottes!$"

CeruleanCity_BikeShop_Text_MakeRoomForBicycle::
    .string "Fais de la place\npour ta Bicyclette!$"

CeruleanCity_BikeShop_Text_CityBikeGoodEnoughForMe::
    .string "Un simple vélo de ville\nme suffit.\pOn ne peut pas mettre\nun panier à provisions sur un VTT.$"

CeruleanCity_BikeShop_Text_BikesCoolButExpensive::
    .string "Ces vélos sont superbes,\nmais vraiment trop chers!$"

CeruleanCity_BikeShop_Text_WowYourBikeIsCool::
    .string "Ouah!\nTa Bicyclette est superbe!$"

@ Unused
CeruleanCity_BikeShop_Text_GermanFoldableBicyleFinallyOnMarket::
    .string "Enfin disponible!\pUn vélo pliant allemand\nhaut de gamme!$"

CeruleanCity_BikeShop_Text_ShinyNewBicycle::
    .string "Une Bicyclette flambant neuve!$"

