Route21_South_Text_JackIntro::
    .string "J'ai attrapé mes Yo-kai en mer.$"

Route21_South_Text_JackDefeat::
    .string "Plongeur en perdition !$"

Route21_South_Text_JackPostBattle::
    .string "Où as-tu attrapé tes Yo-kai ?$"

Route21_South_Text_JeromeIntro::
    .string "Je participe à un triathlon, là.$"

Route21_South_Text_JeromeDefeat::
    .string "Haa… Haa… Haa…$"

Route21_South_Text_JeromePostBattle::
    .string "Je suis à bout ! Et il me reste\nencore le vélo et le marathon !$"

Route21_South_Text_RolandIntro::
    .string "Ah ! Profite du soleil et du vent !$"

Route21_South_Text_RolandDefeat::
    .string "Aïe ! J'ai perdu !$"

Route21_South_Text_RolandPostBattle::
    .string "J'ai attrapé un sacré coup de soleil\n!$"

Route21_South_Text_ClaudeIntro::
    .string "Hé, ne fais pas fuir les poissons !$"

Route21_South_Text_ClaudeDefeat::
    .string "Pardon ! Ne rien attraper me rend\ntellement irritable.$"

Route21_South_Text_ClaudePostBattle::
    .string "Pfff, pas une prise. Ce serait une\npiscine géante, en fait ?$"

Route21_South_Text_NolanIntro::
    .string "Tiens-moi compagnie jusqu'à ce que\nça morde.$"

Route21_South_Text_NolanDefeat::
    .string "Ça m'a fait passer le temps.$"

Route21_South_Text_NolanPostBattle::
    .string "Oh, attends ! Ça mord ! Ouais !$"

Route21_North_Text_LilIntro::
    .string "LIL : Hein ? Un combat ? IAN, tu ne\npeux pas te débrouiller seul ?$"

Route21_North_Text_LilDefeat::
    .string "LIL : Tu vois ? On a perdu. Tu es\ncontent ?$"

Route21_North_Text_LilPostBattle::
    .string "LIL : Je suis fatiguée. On peut\nrentrer, maintenant ?$"

Route21_North_Text_LilNotEnoughMons::
    .string "LIL : Hein ? Un combat ? Je n'ai pas\nenvie de me battre seule. Reviens\lavec deux Yo-kai, d'accord ?$"

Route21_North_Text_IanIntro::
    .string "IAN : Ma sœur ne fait pas assez\nd'exercice, alors je l'ai fait venir.$"

Route21_North_Text_IanDefeat::
    .string "IAN : Oh, frangine ! Ressaisis-toi !$"

Route21_North_Text_IanPostBattle::
    .string "IAN : Allez, frangine !\pCe n'est pas comme ça que tu vas\nperdre du poids !$"

Route21_North_Text_IanNotEnoughMons::
    .string "IAN : On veut un combat à deux\ncontre deux. Tu peux revenir avec\ldeux Yo-kai ?$"
